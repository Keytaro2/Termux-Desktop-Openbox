(defwindow powermenu
  :stacking "fg"
  :windowtype "normal"
  :wm-ignore true
  :geometry (geometry :width "500px"
                      :height "45%"
                      :anchor "center center")
  (box :class "powermenu-overlay"
    (box :class "powermenu-box" :orientation "v" :space-evenly false :halign "center" :valign "center"
      (label :text "Select an action" :class "powermenu-title")

      (box :class "powermenu-row" :spacing 20 :halign "center"
        ;; Action buttons (Configured script paths)
        (p-button :icon "󰌾" :label "Lock" :cmd "eww close powermenu" :col "yellow")
        (p-button :icon "󰍃" :label "Logout" :cmd "/data/data/com.termux/files/home/.config/eww/scripts/power.sh logout" :col "cyan")
        (p-button :icon "󰑐" :label "Reboot" :cmd "/data/data/com.termux/files/home/.config/eww/scripts/power.sh reboot" :col "purple")
        (p-button :icon "󰐥" :label "Shutdown" :cmd "/data/data/com.termux/files/home/.config/eww/scripts/power.sh poweroff" :col "red"))

      ;; CANCEL BUTTON (Direct action to close the window)
      (button :class "powermenu-cancel" :onclick "eww close powermenu" "Cancel")
    )
  )
)

(defwidget p-button [icon label cmd col]
  (box :orientation "v" :space-evenly false :spacing 8
    (button :class "p-icon ${col}" :onclick cmd icon)
    (label :text label :class "p-label")
  )
)
