;; --- POLLERS CONFIGURADOS PARA TU DISPOSITIVO ---
(defpoll cpu_usage :interval "3s"
  "uptime | awk -F'load average:' '{ print $2 }' | cut -d, -f1 | awk '{usage=$1*12.5; if(usage>100) print 100; else print usage}'")

(defpoll ram_usage :interval "5s"
  "free | grep Mem | awk '{print $3/$2 * 100.0}'")

(defpoll song_title :interval "2s" "audtool current-song || echo 'No Music'")
(defpoll song_artist :interval "2s" "audtool current-song-tuple-data artist || echo 'Audacious'")
(defpoll music_status :interval "1s" "audtool playback-status | grep -q 'playing' && echo '󰏤' || echo '󰐊'")
(defpoll time :interval "1s" "date '+%H:%M'")
(defpoll bat :interval "15s" "~/.config/eww/scripts/bateria.sh")

;; --- WINDOW ---
(defwindow target
  :stacking "fg"
  :windowtype "normal"
  :wm-ignore true
  :geometry (geometry :x "150px" :y "10%" :width "340px" :height "500px")
  (dashboard_layout))

;; --- LAYOUT PRINCIPAL (Target - Estilo Seccionado) ---
(defwidget dashboard_layout []
  (box :class "main-container" :orientation "v" :space-evenly false
       :style "background-color: #1a1b26;" 

    ;; Barra de búsqueda
    (box :class "search-bar" :orientation "h" :space-evenly false
      (label :text " " :class "search-icon")
      (label :text "Search..." :class "search-text"))

    ;; Card de Bienvenida
    (box :class "welcome-card" :orientation "v" :space-evenly false
      (label :text "Welcome, Keytaro" :class "welcome-title" :halign "start")
      (label :text "Hello! 👋" :class "welcome-sub" :halign "start")
      (box :class "time-box" :halign "end" :space-evenly false
        (label :text "󱑎 " :class "time-icon")
        (label :text time)))

    ;; Fila de Stats (Círculos con Iconos Centrales Únicamente)
    (box :class "stats-row" :orientation "h" :space-evenly true
      (stat_circle_dash :porcentaje {cpu_usage ?: 0} :icon "󰻠" :etiqueta "Cpu")
      (stat_circle_dash :porcentaje {ram_usage ?: 0} :icon "󰍛" :etiqueta "Ram")
      (stat_circle_dash :porcentaje {bat ?: 0} :icon "󰏈" :etiqueta "Temp"))

    ;; Reproductor de Música (Audacious)
    (box :class "music-card" :orientation "v" :space-evenly false
      (label :text "󰝚 Audacious" :class "music-header")
      (box :orientation "h" :space-evenly false :class "music-info"
        (box :class "album-art" (label :text "󰝚"))
        (box :orientation "v" :valign "center"
          (label :text song_title :limit-width 20 :class "song-name")
          (label :text song_artist :class "artist-name")))

      (box :class "music-controls" :halign "center" :spacing 30
        (button :onclick "audtool playlist-reverse" "󰒮")
        (button :onclick "audtool playback-playpause" music_status)
        (button :onclick "audtool playlist-advance" "󰒭")))
  ))

;; --- Widget Auxiliar: stat_circle_dash (SOLO ICONO CENTRAL) ---
(defwidget stat_circle_dash [porcentaje icon etiqueta]
  (box :class "stat-card-dash" :orientation "v" :space-evenly false :valign "center"
    (label :text etiqueta :style "color: #a0fca0; font-size: 11px; margin-bottom: 6px; font-weight: bold;")
    (box :halign "center"
      (circular-progress :value porcentaje
                         :thickness 9
                         :start-at 75
                         :width 65 :height 65
                         :class "stat-ring"
                         :style "color: #7aa2f7;" 
        (label :text icon :style "font-size: 22px; color: white;")))
  ))
