;; --- Variables y Pollers ---
(defpoll music_cover :interval "2s" "bash ~/.config/eww/scripts/musica.sh")

(defpoll song_title :interval "2s"
  "audtool current-song || echo 'No Music'")

(defpoll song_artist :interval "2s"
  "audtool current-song-tuple-data artist || echo 'Audacious'")

(defpoll music_status :interval "1s"
  "audtool playback-status | grep -q 'playing' && echo '󰏤' || echo '󰐊'")

(defpoll used_root :interval "10m" "~/.config/eww/scripts/almacenamiento.sh root")
(defpoll free_root :interval "10m" "~/.config/eww/scripts/almacenamiento.sh free_root")
(defpoll used_cloud :interval "10m" "~/.config/eww/scripts/almacenamiento.sh cloud")
(defpoll free_cloud :interval "10m" "~/.config/eww/scripts/almacenamiento.sh free_cloud")

(defpoll time :interval "1s" `date +'{"hour":"%H","min":"%M","day":"%d","month":"%m","year":"%Y"}'`)
(defpoll vol  :interval "2s" "~/.config/eww/scripts/volumen.sh")
(defpoll bri  :interval "2s" "~/.config/eww/scripts/brillo.sh")
(defpoll bat  :interval "15s" "~/.config/eww/scripts/bateria.sh")

;; --- Window ---
(defwindow dashboard
  :stacking "fg"
  :windowtype "normal"
  :wm-ignore true
  :geometry (geometry :width "820px" :height "500px" :anchor "center center")
  (main))

;; --- Layout Principal ---
(defwidget main []
  (box :class "bg" :space-evenly false :spacing 15
    ;; Columna 1: Reproductor Audacious
    (box :orientation "v" :space-evenly false :spacing 15
      (box :class "card" :height 320 :width 200 :orientation "v" :space-evenly false
        (box :class "art" :height 160 :width 160 :halign "center" :style "margin-top: 10px; border-radius: 20px; background-image: url('${music_cover}'); background-size: cover; background-position: center;")
        
        (label :text song_title :limit-width 18 :class "m-title" :style "margin-top: 15px;")
        (label :text song_artist :limit-width 20 :style "font-size: 11px; color: #bd93f9; margin-top: 5px;")
        
        (box :class "m-controls" :spacing 20 :halign "center" :style "margin-top: 15px;"
          (button :onclick "audtool playlist-reverse" "󰒮")
          (button :onclick "audtool playback-playpause" music_status)
          (button :onclick "audtool playlist-advance" "󰒭")))
          
      (box :class "card" :height 60 (box :space-evenly false :spacing 10 :halign "center"
          (label :text "󰒓" :style "color: #50fa7b; font-size: 20px;") (label :text "CONFIG" :class "m-title"))))

    ;; Columna 2: Sistema y Almacenamiento
    (box :orientation "v" :space-evenly false :spacing 15
      (box :class "card" :height 180 :width 280 :orientation "v" :spacing 20 :padding 20
        (sys-bar :icon "󰕾" :val {vol ?: 0} :text "${vol ?: 0}%" :col "p")
        (sys-bar :icon "󰃠" :val {bri ?: 0} :text "${bri ?: 0}%" :col "g")
        (sys-bar :icon "󰂄" :val {bat ?: 0} :text "${bat ?: 0}%" :col "w"))
      
      (box :class "card" :height 200 :orientation "v" :space-evenly false
        (box :spacing 40 :halign "center" :style "margin-top: 25px;"
          (disk :lab "/" :v {used_root ?: 0} :free {free_root ?: "0GB"} :c "r")
          (disk :lab "cloud" :v {used_cloud ?: 0} :free {free_cloud ?: "0GB"} :c "b"))))

    ;; Columna 3: Tiempo y Calendario
    (box :orientation "v" :space-evenly false :spacing 15
      (box :class "card" :height 110 :width 250
        (box :space-evenly false :halign "center"
          (label :text "${time.hour}" :class "t-h") (label :text "${time.min}" :class "t-m")))
      (box :class "card" :height 270
        (calendar :day {time.day} :month {time.month} :year {time.year})))
  )
)

;; --- Widgets Auxiliares ---
(defwidget sys-bar [icon val text col]
  (box :space-evenly false :spacing 10
    (label :text icon :style "font-size: 18px; color: #f8f8f2;")
    (scale :min 0 :max 101 :active false :value {val ?: 0} :class "bar-${col}")
    (label :text text :style "font-size: 13px; color: #f8f8f2;")))

(defwidget disk [lab v free c]
  (box :orientation "v" :spacing 5 :space-evenly false
    (label :text lab :style "font-weight: bold; color: #50fa7b; font-size: 16px;")
    
    ;; Contenedor para el anillo y el texto centrado
    (box :class "disk-wrapper" :halign "center" :valign "center"
      (circular-progress :value v
                         :thickness 10 ;; Más grueso para que se vea como en la imagen
                         :start-at 75
                         :class "ring-${c}"
        (label :text "${v}%" :class "disk-percent"))) ;; Clase específica para el porcentaje centrado
        
    (label :text "${free} free" :style "font-size: 11px; color: #6272a4; margin-top: 5px;")))

