;; 1. IMPORT MODULES
(include "./target/eww.yuck")
(include "./powermenu/eww.yuck")

;; 2. DEFINE THE WIDGET (Now with the Arch button included)
(defwidget lanzador []
  (box :class "caja-botones"
       :orientation "h"
       :spacing 15
       :space-evenly false
       :halign "center"

    ;; ARCH BUTTON (Wallpaper Change)
    (button :onclick "~/.config/eww/scripts/change_wp.sh"
            :class "arch-btn"
            :tooltip "Cambiar Fondo" "󰣇")

    ;; Target Button
    (button :onclick "eww open --toggle target"
            :class "btn-target"
            :tooltip "Ver Target" "󰓾")

    ;; Powermenu button
    (button :onclick "eww open --toggle powermenu"
            :class "btn-power"
            :tooltip "Apagar" "⏻")
  )
)

;; 3. MAIN WINDOW (Adjusted to the right)
(defwindow mis_botones
  :monitor 0
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore true
  :geometry (geometry :x "-30px" 
                      :y "10px"
                      :width "170px" ;;
                      :height "55px"
                      :anchor "top right")
  (lanzador))

