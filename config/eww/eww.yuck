;; 1. IMPORT MODULES (Using absolute paths for better stability in Termux)
(include "/data/data/com.termux/files/home/.config/eww/target/eww.yuck")
(include "/data/data/com.termux/files/home/.config/eww/powermenu/eww.yuck")
(include "/data/data/com.termux/files/home/.config/eww/cpu/eww.yuck")

;; 2. DEFINE THE MAIN WIDGET
(defwidget launcher []
  (box :class "button-box"
       :orientation "h"
       :spacing 15
       :space-evenly false
       :halign "center"

    ;; ARCH BUTTON
    (button :onclick "/data/data/com.termux/files/home/.config/eww/scripts/change_wp.sh"
            :class "arch-btn"
            :tooltip "Change Wallpaper" "󰣇")

    ;; CPU BUTTON
    ;; Note: Make sure that in /cpu/eww.yuck the window is named exactly 'cpu'
    (button :onclick "eww open --toggle cpu"
            :class "btn-cpu"
            :tooltip "System Monitor" "󰻠")

    ;; TARGET BUTTON
    (button :onclick "eww open --toggle target"
            :class "btn-target"
            :tooltip "View Target" "󰓾")

    ;; POWERMENU BUTTON
    (button :onclick "eww open --toggle powermenu"
            :class "btn-power"
            :tooltip "Shutdown" "⏻")
  )
)

;; 3. MAIN WINDOW
(defwindow my_buttons
  :monitor 0
  :stacking "fg"
  :windowtype "dialog"
  :wm-ignore true
  :geometry (geometry :x "-30px"
                      :y "10px"
                      :width "230px"
                      :height "55px"
                      :anchor "top right")
  (launcher)
)

