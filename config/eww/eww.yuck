;; 1. IMPORTAR MÓDULOS
(include "./target/eww.yuck")
(include "./powermenu/eww.yuck")
(include "./cpu/eww.yuck") 

;; 2. DEFINIR EL WIDGET
(defwidget lanzador []
  (box :class "caja-botones"
       :orientation "h"
       :spacing 15
       :space-evenly false
       :halign "center"

    ;; BOTÓN DE ARCH
    (button :onclick "~/.config/eww/scripts/change_wp.sh"
            :class "arch-btn"
            :tooltip "Cambiar Fondo" "󰣇")

    ;; BOTÓN DE CPU (Abre la ventana 'cpu' definida en el include)
    (button :onclick "eww open --toggle cpu"
            :class "btn-cpu"
            :tooltip "Monitor de Sistema" "󰻠")

    ;; Botón del Target
    (button :onclick "eww open --toggle target"
            :class "btn-target"
            :tooltip "Ver Target" "󰓾")

    ;; Botón del Powermenu
    (button :onclick "eww open --toggle powermenu"
            :class "btn-power"
            :tooltip "Apagar" "⏻")
  )
)

;; 3. VENTANA PRINCIPAL
(defwindow mis_botones
  :monitor 0
  :stacking "fg"
  :windowtype "dialog"
  :wm-ignore true
  :geometry (geometry :x "-30px"
                      :y "10px"
                      :width "230px" 
                      :height "55px"
                      :anchor "top right")
  (lanzador))
