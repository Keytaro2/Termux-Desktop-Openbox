! X colors.
! Generated by 'wal'
*foreground:        #c1c2c4
*background:        #090b15
*.foreground:       #c1c2c4
*.background:       #090b15
emacs*foreground:   #c1c2c4
emacs*background:   #090b15
URxvt*foreground:   #c1c2c4
XTerm*foreground:   #c1c2c4
UXTerm*foreground:  #c1c2c4
URxvt*background:   [100]#090b15
XTerm*background:   #090b15
UXTerm*background:  #090b15
URxvt*cursorColor:  #c1c2c4
XTerm*cursorColor:  #c1c2c4
UXTerm*cursorColor: #c1c2c4
URxvt*borderColor:  [100]#090b15

! Colors 0-15.
*.color0: #090b15
*color0:  #090b15
*.color1: #2F558E
*color1:  #2F558E
*.color2: #35609F
*color2:  #35609F
*.color3: #355FA0
*color3:  #355FA0
*.color4: #3967AC
*color4:  #3967AC
*.color5: #3B6BB3
*color5:  #3B6BB3
*.color6: #3D6EBA
*color6:  #3D6EBA
*.color7: #c1c2c4
*color7:  #c1c2c4
*.color8: #585b6c
*color8:  #585b6c
*.color9: #2F558E
*color9:  #2F558E
*.color10: #35609F
*color10:  #35609F
*.color11: #355FA0
*color11:  #355FA0
*.color12: #3967AC
*color12:  #3967AC
*.color13: #3B6BB3
*color13:  #3B6BB3
*.color14: #3D6EBA
*color14:  #3D6EBA
*.color15: #c1c2c4
*color15:  #c1c2c4

! Black color that will not be affected by bold highlighting.
*.color66: #090b15
*color66:  #090b15

! Xclock colors.
XClock*foreground: #c1c2c4
XClock*background: #090b15
XClock*majorColor:  rgba:c1/c2/c4/ff
XClock*minorColor:  rgba:c1/c2/c4/ff
XClock*hourColor:   rgba:c1/c2/c4/ff
XClock*minuteColor: rgba:c1/c2/c4/ff
XClock*secondColor: rgba:c1/c2/c4/ff

! Set depth to make transparency work.
URxvt*depth: 32
